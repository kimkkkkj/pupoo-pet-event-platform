PORT=8000
PUPOO_AI_SERVICE_NAME=pupoo-ai
PUPOO_AI_LOG_LEVEL=INFO
# 로컬 개발용 예시 값이다. 프로젝트별 별도 토큰으로 바꿔 사용한다.
PUPOO_AI_INTERNAL_TOKEN=
PUPOO_AI_PREVIOUS_INTERNAL_TOKENS=
# 챗봇 LLM: bedrock(AWS) | gemini / groq / openai (CHATBOT_API_KEY/BASE_URL/MODEL 사용)
PUPOO_AI_CHATBOT_PROVIDER=bedrock
PUPOO_AI_CHATBOT_API_KEY=
PUPOO_AI_CHATBOT_BASE_URL=
PUPOO_AI_CHATBOT_MODEL=
PUPOO_AI_AWS_REGION=us-east-1
PUPOO_AI_BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
# 포스터: free(Pollinations 무료 배경 + 한글 글자 합성) | openai | bedrock
# POSTER_FREE_TOKEN: Pollinations 무료 가입 토큰(있으면 로고 없이 FLUX로 생성, 없어도 동작)
# bedrock: Stability Stable Image Core(유료, 1장 약 $0.04, 챗봇과 같은 AWS 키) | free: Pollinations(무료, 품질 들쭉날쭉)
PUPOO_AI_POSTER_PROVIDER=bedrock
PUPOO_AI_POSTER_BEDROCK_REGION=us-west-2
# 하루(한국 시간) 최대 생성 장수, 0이면 제한 없음
PUPOO_AI_POSTER_DAILY_LIMIT=30
PUPOO_AI_POSTER_FREE_TOKEN=
PUPOO_AI_REDIS_URL=redis://localhost:6379/0
PUPOO_AI_DB_URL=
PUPOO_AI_DB_HOST=
PUPOO_AI_DB_PORT=3306
PUPOO_AI_DB_USER=
PUPOO_AI_DB_PASSWORD=
PUPOO_AI_DB_NAME=
PUPOO_AI_DB_CHARSET=utf8mb4
PUPOO_AI_DB_CONNECT_TIMEOUT=5
PUPOO_AI_DB_READ_TIMEOUT=10
PUPOO_AI_DB_WRITE_TIMEOUT=10
PUPOO_AI_DB_SSL_CA=
PUPOO_AI_POSTER_PROVIDER=openai
PUPOO_AI_POSTER_OPENAI_MODEL=dall-e-3
PUPOO_AI_POSTER_OPENAI_BASE_URL=https://api.openai.com/v1
PUPOO_AI_POSTER_BEDROCK_MODEL=stability.stable-image-core-v1:1
PUPOO_AI_POSTER_DEFAULT_WIDTH=400
PUPOO_AI_POSTER_DEFAULT_HEIGHT=847
PUPOO_AI_POSTER_STORAGE_PREFIX=posters/generated
PUPOO_AI_POSTER_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# watsonx.ai (금지어 RAG: LLM + 임베딩)
PUPOO_AI_WATSONX_API_KEY=
PUPOO_AI_WATSONX_URL=https://us-south.ml.cloud.ibm.com
PUPOO_AI_WATSONX_PROJECT_ID=your-project-id
PUPOO_AI_WATSONX_REGION=us-south
PUPOO_AI_WATSONX_LLM_ID=meta-llama/llama-3-3-70b-instruct
# 정책 Milvus 검색용 임베딩 (모델 카드의 벡터 차원과 DIM을 반드시 일치)
PUPOO_AI_WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual
PUPOO_AI_WATSONX_EMBEDDING_DIM=768

# Milvus (정책 벡터 저장소). Windows에서 연결 실패 시 127.0.0.1 사용
PUPOO_AI_MILVUS_HOST=127.0.0.1
PUPOO_AI_MILVUS_PORT=19530
PUPOO_AI_MILVUS_TLS=false
PUPOO_AI_MILVUS_USERNAME=
PUPOO_AI_MILVUS_PASSWORD=
PUPOO_AI_MILVUS_COLLECTION=policy_vectors

{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s [%(name)s] %(message)s"
    },
    "access": {
      "format": "%(asctime)s %(levelname)s [access] %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    },
    "file": {
      "class": "logging.FileHandler",
      "formatter": "default",
      "filename": "logs/ai_server.log",
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "console",
        "file"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": [
      "console",
      "file"
    ],
    "level": "INFO"
  }
}
